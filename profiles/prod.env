# DWIP Enterprise — Production Profile
# -------------------------------------------------------------
NODE_ENV=production
PORT=8080

# Production Cloud SQL database connections
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=prodsecretpasswordplaceholder
DB_DATABASE=dwip_production

# JWT Keys (Should be injected securely in production from Cloud Secrets Manager)
JWT_SECRET=production_jwt_secret_signing_key_dwip_enterprise_100_replace_in_secrets
CUSTOMER_JWT_SECRET=production_customer_jwt_secret_signing_key_dwip_enterprise_200_replace_in_secrets
VITE_WORKFORCE_PROFILE=rc1

