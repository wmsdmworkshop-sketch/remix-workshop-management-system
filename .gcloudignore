# Ignore Git
.git/
.gitignore

# Ignore dependencies and build artifacts
node_modules/
dist/

# Ignore mobile projects to prevent path limit issues or large uploads
wms-workshop/
Project/

# Ignore environments
.env
.env.*
!.env.example

# Ignore OS-specific files
.DS_Store

# Ignore large documents and databases
*.xlsx
*.csv
*.sql
*.png
workshop_db.json
employees_backup.json
employee_master_backup.json
railway_dump.sql

# Ignore local configs
.idea/
.vscode/

android/

# Transient / sensitive scratch files — keep out of the Cloud Build upload
*.cjs
bucket_iam_backup.json
db_schema.txt
dev/
scripts/
src/scripts/
test_engine.js
.artifacts/

# Archived files removed from the app (see _quarantine/MANIFEST.md). 378.7 MB and
# never needed to build — it was the bulk of every deploy upload. Also gitignored,
# so a fresh checkout would not have it either; excluding it keeps CI and local
# deploys uploading the same set.
_quarantine/

